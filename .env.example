AUTH_SECRET=generate-a-long-random-secret
AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-client-secret
AUTH_URL=http://localhost:3000
# For production on BOTH wydrian.hu and nas.wydrian.hu: remove AUTH_URL/NEXTAUTH_URL and set true.
# Register both exact HTTPS Google callback URLs first. Sessions stay host-only.
AUTH_MULTI_DOMAIN=false
# Protected bootstrap owner/admin; additional active accounts are managed in SQLite via Konfig / Felhasználók.
ALLOWED_EMAIL=wydrian@gmail.com
 
# Android push: service-account JSON stays on the server, NEVER inside the APK.
POKEMON_FCM_CREDENTIALS=
POKEMON_PUSH_ENABLED=false

# Public Collectr / Frankfurter / KSH requests for the admin finance page. Disable for isolated/offline tests.
FINANCE_EXTERNAL_FETCH_ENABLED=true

# Owner-only OpenCode web gateway; enable only after gateway/TLS setup.
OPENCODE_WEB_ENABLED=false

# Owner-only, fixed-service restart helper. Enable after local UAC installation.
ADMIN_HELPER_ENABLED=false

# Read-only eToro Total Balance prefill for the existing eToro (stock) row.
# Server credentials: .runtime/secrets/etoro.json (never commit).
FINANCE_ETORO_ENABLED=false
