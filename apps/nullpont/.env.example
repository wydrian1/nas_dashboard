# No Google OAuth client or Google secret needed: existing dashboard login is used.
AUTH_SECRET=generate-a-separate-long-random-session-secret
AUTH_URL=http://127.0.0.1:3100
NULLPONT_DASHBOARD_URL=https://nas.wydrian.hu
# Same dedicated random bridge secret as dashboard NULLPONT_SSO_SECRET (32+ chars).
# NOT the dashboard AUTH_SECRET. Keep this server-side only.
NULLPONT_SSO_SECRET=
# Absolute independent directory; back this up separately. Default: ./data
NULLPONT_DATA_DIR=
