# Independent credentials and callback: https://YOUR-GAME-HOST/api/auth/callback/google
# Do not reuse a dashboard cookie secret. No parent-domain cookies.
AUTH_SECRET=generate-a-separate-long-random-secret
AUTH_GOOGLE_ID=your-game-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-game-client-secret
AUTH_URL=http://localhost:3100
NULLPONT_ALLOWED_EMAILS=owner@example.test
# Absolute directory; back this up separately. Default: ./data
NULLPONT_DATA_DIR=
