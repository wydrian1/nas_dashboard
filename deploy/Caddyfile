{
    # Port 80 is handed over from IIS by the owner-approved activation script.
    # Automatic HTTP redirects and the apex ZeroSSL HTTP-01 challenge use that port.
    admin off
    storage file_system {
        root data/caddy
    }
}

# Private snippet contains the ZeroSSL EAB credentials; never publish or serve this file.
import ../.runtime/secrets/zerossl-apex.caddy

wydrian.hu {
    import zerossl-apex
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000"
    @backupInfo path /backup-info.html /backup-privacy.html
    # Independent NULLPONT service; preserve the base path (do not use handle_path).
    @nullpont path /nullpont /nullpont/*
    handle @nullpont {
        reverse_proxy 127.0.0.1:3100
    }
    handle @backupInfo {
        root * deploy/backup-public
        file_server
    }
    handle {
        reverse_proxy 127.0.0.1:3000
    }
}

opencode.nas.wydrian.hu {
    tls {
        issuer acme {
            disable_http_challenge
        }
    }
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy 127.0.0.1:3101 {
        flush_interval -1
    }
}

nas.wydrian.hu {
    tls {
        issuer acme {
            disable_http_challenge
        }
    }
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000"
    # Only these two informational files are public; no dashboard or backup data.
    @backupInfo path /backup-info.html /backup-privacy.html
    handle @backupInfo {
        root * deploy/backup-public
        file_server
    }
    handle {
        reverse_proxy 127.0.0.1:3000
    }
}
